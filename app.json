{
  "expo": {
    "name": "KaizenWorkshop",
    "slug": "KaizenWorkshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kaizenworkshop",
    "userInterfaceStyle": "light",
    "android": {
      "package": "br.com.weg.kaizenworkshop",
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "br.com.weg.kaizenworkshop"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
